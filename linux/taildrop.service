[Unit]
Description=Receive Taildrop files into Downloads/Taildrop

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/Downloads/Taildrop
ExecStart=/usr/bin/tailscale file get --loop --verbose --conflict=rename %h/Downloads/Taildrop
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
