exists() {
  command -v "$1" >/dev/null 2>&1
}

# disable ZSH beeping like mad
unsetopt beep;

# ─── BEGIN mirrored block ───
# Keep in sync with nu/env.nu and nu/config.nu (manual sync, no codegen)
# Precedence: terminal shims, Volta, ~/bin, Homebrew, inherited PATH,
# then Cargo, ~/.local/bin and .NET. Keep the first copy of each entry.

if [[ "$(uname)" == "Darwin" ]]; then
  export PATH="/opt/homebrew/bin:$PATH"
else
  export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
fi

export PATH="$HOME/.volta/bin:$HOME/bin:$PATH:$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.dotnet:$HOME/.dotnet/tools"
export PATH="$HOME/.ddcoterm/bin:$HOME/.ddcoterm/overrides:$PATH"

if [[ "$(uname)" == "Darwin" ]]; then
  export PATH="$PATH:/usr/local/bin"
elif [[ "$(uname)" == "Linux" ]]; then
  export PATH="$PATH:/snap/bin"
fi
typeset -U path PATH

export EDITOR=micro
export VISUAL=micro

mkd() {
	mkdir "$1" && cd "$1"
}

# ─── END mirrored block ───

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history
setopt share_history
setopt hist_ignore_dups
setopt hist_reduce_blanks
setopt auto_cd
setopt interactive_comments

# Completion
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Keybindings
bindkey -e
autoload -Uz up-line-or-beginning-search
autoload -Uz down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

export LANG=en_US.UTF-8

source ~/.zsh-plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

source <(fzf --zsh)

alias mi=micro
alias ddb="duckdb :memory:"

eval "$(starship init zsh)"
